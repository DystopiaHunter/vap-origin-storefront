{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vap-origin-storefront",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "vap_origin_db",
      "database_name": "vap-origin-db",
      "database_id": "cf60b89e-03fc-46f8-9c56-e403c4203ccc",
      "migrations_dir": "migrations"
    }
  ]
}